# Copy to .env.deploy.local for a localhost-only Compose environment.
PUBLIC_ORIGIN=https://localhost:8443
VIBICLE_DOMAIN=localhost
CADDY_TLS_DIRECTIVE=tls internal
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443
POSTGRES_DB=vibicle
POSTGRES_USER=vibicle_migrator
POSTGRES_PASSWORD=replace_with_a_local_random_password
RUNTIME_PASSWORD=replace_with_an_independent_runtime_password
RATE_LIMIT_SECRET=replace_with_an_independent_local_secret
